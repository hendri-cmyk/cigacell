            const activeBtn = document.getElementById(`brand-${brand}`);
            if (activeBtn) {
                activeBtn.className = "brand-btn bg-blue-600 text-white px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition";
            }

            applyFilters();
