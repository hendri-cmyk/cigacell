                            <span class="text-xs font-bold text-gray-800 dark:text-white">${item.quantity}</span>
                            <button onclick="updateQuantity(${item.id}, 1)" class="w-6 h-6 rounded-lg bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-white flex items-center justify-center font-bold text-xs hover:bg-gray-300">+</button>
