                    </div>
                `;
                return;
            }

            checkoutBtn.disabled = false;
            container.innerHTML = '';

            cart.forEach(item => {
                const itemEl = document.createElement('div');
                itemEl.className = "flex items-center space-x-4 bg-gray-50 dark:bg-gray-700/50 p-3 rounded-2xl border border-gray-100 dark:border-gray-700";
