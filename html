l.<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GigaCell - Toko Smartphone Resmi & Terpercaya</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Font Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                        }
                    }
                }
            }
        }
    </script>
    
    <style>
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        .dark ::-webkit-scrollbar-track {
            background: #1f2937;
        }
        ::-webkit-scrollbar-thumb {
            background: #9ca3af;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #6b7280;
        }
    </style>
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-800 dark:text-gray-100 font-sans transition-colors duration-300 min-h-screen flex flex-col">

    <!-- HEADER / NAVIGATION -->
    <header class="sticky top-0 z-40 bg-white/90 dark:bg-gray-800/90 backdrop-blur-md border-b border-gray-200 dark:border-gray-700 shadow-sm transition-colors">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                
                <!-- Logo -->
                <div class="flex items-center space-x-3 cursor-pointer" onclick="resetFilters()">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-blue-500/30">
                        <i class="fa-solid font-bold fa-mobile-screen-button"></i>
                    </div>
                    <span class="text-xl font-extrabold bg-gradient-to-r from-blue-600 to-indigo-500 bg-clip-text text-transparent">GigaCell</span>
                </div>

                <!-- Search Bar Desktop -->
                <div class="hidden md:flex flex-1 max-w-md mx-8 relative">
                    <input type="text" id="searchInput" oninput="handleSearch()" placeholder="Cari smartphone favoritmu (cth: iPhone 15, Galaxy S24)..." 
                        class="w-full pl-10 pr-4 py-2 rounded-full border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:text-white transition-all">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-gray-400"></i>
                </div>

                <!-- Action Controls -->
                <div class="flex items-center space-x-3">
                    
                    <!-- Dark Mode Toggle -->
                    <button onclick="toggleDarkMode()" class="p-2 rounded-xl text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition">
                        <i id="themeIcon" class="fa-solid fa-moon text-lg"></i>
                    </button>

                    <!-- Compare Button -->
                    <button onclick="openCompareModal()" class="relative p-2 rounded-xl text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition">
                        <i class="fa-solid fa-code-compare text-lg"></i>
                        <span id="compareBadge" class="hidden absolute -top-1 -right-1 bg-indigo-600 text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center">0</span>
                    </button>

                    <!-- Wishlist Button -->
                    <button onclick="openWishlistModal()" class="relative p-2 rounded-xl text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition">
                        <i class="fa-regular fa-heart text-lg"></i>
                        <span id="wishlistBadge" class="hidden absolute -top-1 -right-1 bg-red-500 text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center">0</span>
                    </button>

                    <!-- Cart Button -->
                    <button onclick="toggleCartDrawer()" class="relative flex items-center space-x-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl transition shadow-md shadow-blue-500/20">
                        <i class="fa-solid fa-cart-shopping"></i>
                        <span class="hidden sm:inline font-medium text-sm">Keranjang</span>
                        <span id="cartCount" class="bg-white text-blue-600 text-xs font-bold rounded-full px-2 py-0.5">0</span>
                    </button>
                </div>
            </div>

            <!-- Mobile Search Bar -->
            <div class="pb-3 md:hidden">
                <div class="relative">
                    <input type="text" id="mobileSearchInput" oninput="handleSearchMobile()" placeholder="Cari smartphone..." 
                        class="w-full pl-10 pr-4 py-2 rounded-full border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-white">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-gray-400"></i>
                </div>
            </div>
        </div>
    </header>

    <!-- HERO / BANNER SECTION -->
    <section class="bg-gradient-to-r from-blue-700 via-indigo-700 to-purple-800 text-white py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between relative z-10">
            <div class="mb-8 md:mb-0 text-center md:text-left md:max-w-xl">
                <span class="bg-blue-500/30 text-blue-200 text-xs font-semibold uppercase tracking-wider px-3 py-1 rounded-full border border-blue-400/30 mb-3 inline-block">Promo Spesial Bulan Ini</span>
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight">Dapatkan Smartphone Impian Bergaransi Resmi</h1>
                <p class="mt-3 text-blue-100 text-sm sm:text-base">Diskon hingga 25% + Gratis Ongkir ke seluruh Indonesia. Pengiriman cepat & aman 100% original.</p>
                <div class="mt-6 flex flex-wrap justify-center md:justify-start gap-4">
                    <a href="#katalog" class="bg-white text-blue-700 hover:bg-blue-50 px-6 py-3 rounded-xl font-bold text-sm shadow-lg transition">Jelajahi Produk</a>
                    <button onclick="filterByBrand('Apple')" class="bg-blue-600/50 hover:bg-blue-600 border border-blue-400/40 text-white px-5 py-3 rounded-xl font-medium text-sm transition">
                        <i class="fa-brands fa-apple mr-2"></i> Apple Store
                    </button>
                </div>
            </div>
            <!-- Featured Highlight -->
            <div class="w-full md:w-auto flex justify-center">
                <div class="bg-white/10 backdrop-blur-md p-4 rounded-2xl border border-white/20 shadow-2xl max-w-xs text-center transform hover:scale-105 transition duration-300">
                    <span class="bg-red-500 text-white text-xs font-bold px-2 py-1 rounded absolute top-2 right-2">HOT DEAL</span>
                    <img src="https://images.unsplash.com/photo-1695048133142-1a20484d2569?w=500&auto=format&fit=crop&q=60" alt="iPhone 15 Pro" class="h-48 mx-auto object-contain drop-shadow-lg mb-3 rounded-xl">
                    <h3 class="font-bold text-lg">iPhone 15 Pro Max</h3>
                    <p class="text-xs text-blue-200 mt-1">Chip A17 Pro • Kamera 48MP • Titanium</p>
                    <div class="mt-3 text-xl font-extrabold text-yellow-300">Rp 22.999.000</div>
                    <button onclick="addToCart(1)" class="mt-3 w-full bg-blue-500 hover:bg-blue-600 text-white text-xs font-bold py-2 rounded-lg transition">Tambah ke Keranjang</button>
                </div>
            </div>
        </div>
    </section>

    <!-- MAIN CONTENT / CATALOG -->
    <main id="katalog" class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <!-- Filter and Categories Bar -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 bg-white dark:bg-gray-800 p-4 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700">
            
            <!-- Brand Filters -->
            <div class="flex items-center gap-2 overflow-x-auto pb-2 md:pb-0 no-scrollbar">
                <button onclick="filterByBrand('all')" id="brand-all" class="brand-btn bg-blue-600 text-white px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition">Semua Brand</button>
                <button onclick="filterByBrand('Apple')" id="brand-Apple" class="brand-btn bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-gray-600 px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition">Apple</button>
                <button onclick="filterByBrand('Samsung')" id="brand-Samsung" class="brand-btn bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-gray-600 px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition">Samsung</button>
                <button onclick="filterByBrand('Xiaomi')" id="brand-Xiaomi" class="brand-btn bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-gray-600 px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition">Xiaomi</button>
                <button onclick="filterByBrand('ASUS')" id="brand-ASUS" class="brand-btn bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-gray-600 px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition">ASUS ROG</button>
                <button onclick="filterByBrand('Vivo')" id="brand-Vivo" class="brand-btn bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-gray-600 px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition">Vivo</button>
            </div>

            <!-- Sorting Dropdown -->
            <div class="flex items-center space-x-2 self-end md:self-auto">
                <label for="sortBy" class="text-xs text-gray-500 dark:text-gray-400 font-medium whitespace-nowrap">Urutkan:</label>
                <select id="sortBy" onchange="sortProducts()" class="bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-800 dark:text-white text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 p-2">
                    <option value="default">Rekomendasi</option>
                    <option value="price-low">Harga: Rendah ke Tinggi</option>
                    <option value="price-high">Harga: Tinggi ke Rendah</option>
                    <option value="name">Nama (A-Z)</option>
                </select>
            </div>
        </div>

        <!-- Product Count Indicator -->
        <div class="mb-4 flex items-center justify-between">
            <h2 class="text-xl font-bold text-gray-800 dark:text-white">Katalog Smartphone</h2>
            <span id="productCount" class="text-xs text-gray-500 dark:text-gray-400 font-medium">Menampilkan 0 Produk</span>
        </div>

        <!-- Product Grid -->
        <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            <!-- Dynamic JavaScript content injected here -->
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="hidden text-center py-16">
            <i class="fa-solid fa-mobile-screen text-6xl text-gray-300 dark:text-gray-600 mb-4"></i>
            <h3 class="text-lg font-bold text-gray-700 dark:text-gray-300">Produk Tidak Ditemukan</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Coba kata kunci pencarian lain atau pilih kategori brand berbeda.</p>
            <button onclick="resetFilters()" class="mt-4 bg-blue-600 text-white text-xs font-bold px-4 py-2 rounded-xl">Reset Filter</button>
        </div>
    </main>

    <!-- SHOPPING CART SLIDE-OVER DRAWER -->
    <div id="cartDrawer" class="fixed inset-0 z-50 overflow-hidden hidden" aria-labelledby="slide-over-title" role="dialog" aria-modal="true">
        <div class="absolute inset-0 bg-gray-900/60 backdrop-blur-sm transition-opacity" onclick="toggleCartDrawer()"></div>

        <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
            <div class="w-screen max-w-md bg-white dark:bg-gray-800 shadow-xl flex flex-col">
                
                <!-- Drawer Header -->
                <div class="p-6 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
                    <div class="flex items-center space-x-2">
                        <i class="fa-solid fa-cart-shopping text-blue-600 dark:text-blue-400 text-xl"></i>
                        <h2 class="text-lg font-bold text-gray-900 dark:text-white">Keranjang Belanja</h2>
                    </div>
                    <button onclick="toggleCartDrawer()" class="text-gray-400 hover:text-gray-500 dark:hover:text-gray-300 p-2">
                        <i class="fa-solid fa-xmark text-xl"></i>
                    </button>
                </div>

                <!-- Drawer Content -->
                <div id="cartItemsContainer" class="flex-1 overflow-y-auto p-6 space-y-4">
                    <!-- Dynamic Cart Items -->
                </div>

                <!-- Drawer Footer -->
                <div class="p-6 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50 space-y-4">
                    <div class="flex justify-between text-base font-medium text-gray-900 dark:text-white">
                        <p>Total Subtotal</p>
                        <p id="cartSubtotal" class="font-extrabold text-blue-600 dark:text-blue-400">Rp 0</p>
                    </div>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Pajak dan biaya pengiriman dihitung saat pendaftaran checkout.</p>
                    <div class="space-y-2">
                        <button onclick="openCheckoutModal()" id="checkoutBtn" disabled class="w-full bg-blue-600 hover:bg-blue-700 disabled:bg-gray-300 disabled:cursor-not-allowed text-white font-bold py-3 rounded-xl transition shadow-lg shadow-blue-500/30 flex items-center justify-center space-x-2">
                            <span>Lanjut ke Checkout</span>
                            <i class="fa-solid fa-arrow-right text-xs"></i>
                        </button>
                        <button onclick="clearCart()" class="w-full bg-gray-200 dark:bg-gray-700 hover:bg-red-100 dark:hover:bg-red-900/30 text-gray-700 dark:text-gray-300 hover:text-red-600 dark:hover:text-red-400 font-semibold py-2 rounded-xl text-xs transition">
                            Kosongkan Keranjang
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- PRODUCT DETAIL MODAL -->
    <div id="productModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
        <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
            <div class="fixed inset-0 bg-gray-900/70 backdrop-blur-sm transition-opacity" onclick="closeProductModal()"></div>
            <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
            
            <div class="inline-block align-bottom bg-white dark:bg-gray-800 rounded-3xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full border border-gray-100 dark:border-gray-700">
                <div id="modalContent" class="p-6 sm:p-8">
                    <!-- Dynamic Details Injected Here -->
                </div>
            </div>
        </div>
    </div>

    <!-- CHECKOUT FORM MODAL -->
    <div id="checkoutModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
        <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
            <div class="fixed inset-0 bg-gray-900/70 backdrop-blur-sm transition-opacity" onclick="closeCheckoutModal()"></div>
            <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
            
            <div class="inline-block align-bottom bg-white dark:bg-gray-800 rounded-3xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full border border-gray-100 dark:border-gray-700">
                <div class="p-6 sm:p-8">
                    <div class="flex justify-between items-center pb-4 mb-4 border-b border-gray-200 dark:border-gray-700">
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white flex items-center">
                            <i class="fa-solid fa-file-invoice text-blue-600 mr-2"></i> Form Pemesanan
                        </h3>
                        <button onclick="closeCheckoutModal()" class="text-gray-400 hover:text-gray-500">
                            <i class="fa-solid fa-xmark text-xl"></i>
                        </button>
                    </div>

                    <form id="checkoutForm" onsubmit="processOrder(event)" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase mb-1">Nama Lengkap</label>
                            <input type="text" required id="custName" placeholder="Budi Santoso" class="w-full px-4 py-2 rounded-xl border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-sm dark:text-white focus:ring-2 focus:ring-blue-500 outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase mb-1">Nomor WhatsApp</label>
                            <input type="tel" required id="custPhone" placeholder="081234567890" class="w-full px-4 py-2 rounded-xl border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-sm dark:text-white focus:ring-2 focus:ring-blue-500 outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase mb-1">Alamat Pengiriman</label>
                            <textarea required id="custAddress" rows="3" placeholder="Jl. Sudirman No. 12, Jakarta Selatan..." class="w-full px-4 py-2 rounded-xl border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-sm dark:text-white focus:ring-2 focus:ring-blue-500 outline-none"></textarea>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase mb-1">Metode Pembayaran</label>
                            <select id="paymentMethod" class="w-full px-4 py-2 rounded-xl border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-sm dark:text-white focus:ring-2 focus:ring-blue-500 outline-none">
                                <option value="Transfer Bank (BCA/Mandiri)">Transfer Bank (BCA / Mandiri / BRI)</option>
                                <option value="E-Wallet (Gopay/OVO/Dana)">E-Wallet (Gopay / OVO / DANA / QRIS)</option>
                                <option value="COD (Bayar di Tempat)">COD (Bayar di Tempat)</option>
                            </select>
                        </div>

                        <div class="pt-4 border-t border-gray-200 dark:border-gray-700">
                            <div class="flex justify-between items-center mb-4">
                                <span class="text-sm font-semibold text-gray-700 dark:text-gray-300">Total Pembayaran:</span>
                                <span id="checkoutTotal" class="text-xl font-extrabold text-blue-600 dark:text-blue-400">Rp 0</span>
                            </div>
                            <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 rounded-xl transition shadow-lg shadow-green-500/30 flex items-center justify-center space-x-2">
                                <i class="fa-brands fa-whatsapp text-lg"></i>
                                <span>Pesan via WhatsApp</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- COMPARE MODAL -->
    <div id="compareModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
        <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
            <div class="fixed inset-0 bg-gray-900/70 backdrop-blur-sm transition-opacity" onclick="closeCompareModal()"></div>
            <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
            
            <div class="inline-block align-bottom bg-white dark:bg-gray-800 rounded-3xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-4xl sm:w-full border border-gray-100 dark:border-gray-700">
                <div class="p-6 sm:p-8">
                    <div class="flex justify-between items-center pb-4 mb-6 border-b border-gray-200 dark:border-gray-700">
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white flex items-center">
                            <i class="fa-solid fa-code-compare text-blue-600 mr-2"></i> Komparasi Spesifikasi Smartphone
                        </h3>
                        <button onclick="closeCompareModal()" class="text-gray-400 hover:text-gray-500">
                            <i class="fa-solid fa-xmark text-xl"></i>
                        </button>
                    </div>

                    <div id="compareContent" class="overflow-x-auto">
                        <!-- Dynamic Compare Content -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 transition-colors mt-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
                <div>
                    <div class="flex items-center space-x-2 mb-4">
                        <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold">
                            <i class="fa-solid fa-mobile-screen-button"></i>
                        </div>
                        <span class="text-lg font-extrabold text-gray-900 dark:text-white">GigaCell</span>
                    </div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">
                        Pusat penjualan smartphone terbesar dan terpercaya dengan jaminan garansi resmi 100% original. Kepuasan Anda adalah prioritas utama kami.
                    </p>
                </div>

                <div>
                    <h4 class="text-sm font-bold text-gray-900 dark:text-white uppercase mb-4">Brand Populer</h4>
                    <ul class="space-y-2 text-xs text-gray-500 dark:text-gray-400">
                        <li><a href="#katalog" onclick="filterByBrand('Apple')" class="hover:text-blue-600">iPhone / Apple</a></li>
                        <li><a href="#katalog" onclick="filterByBrand('Samsung')" class="hover:text-blue-600">Samsung Galaxy</a></li>
                        <li><a href="#katalog" onclick="filterByBrand('Xiaomi')" class="hover:text-blue-600">Xiaomi / Poco</a></li>
                        <li><a href="#katalog" onclick="filterByBrand('ASUS')" class="hover:text-blue-600">ASUS ROG Gaming</a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="text-sm font-bold text-gray-900 dark:text-white uppercase mb-4">Layanan Pelanggan</h4>
                    <ul class="space-y-2 text-xs text-gray-500 dark:text-gray-400">
                        <li><a href="#" class="hover:text-blue-600">Cek Status Garansi</a></li>
                        <li><a href="#" class="hover:text-blue-600">Kebijakan Pengembalian</a></li>
                        <li><a href="#" class="hover:text-blue-600">Syarat & Ketentuan</a></li>
                        <li><a href="#" class="hover:text-blue-600">FAQ / Bantuan</a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="text-sm font-bold text-gray-900 dark:text-white uppercase mb-4">Hubungi Kami</h4>
                    <div class="space-y-3 text-xs text-gray-500 dark:text-gray-400">
